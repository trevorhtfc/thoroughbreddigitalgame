{
  "id": "ascot-home-straight",
  "name": "Ascot · home straight (look test)",
  "notes": "Look test: 5 furlongs of straight finishing at the winning post. The full Ascot round course will be traced from the A0 board (New_Plan_Print.pdf) into this same format.",
  "units": "metres",
  "axes": "x = direction of running, y = up, z = across the course (+ towards the stands side)",

  "track": {
    "centreLine": [[-160, 0, 0], [1200, 0, 0]],
    "width": 30,
    "lanes": 8,
    "turfTexture": "turf",
    "turfTileLength": 30
  },

  "raceDistance": 1006,
  "start": 0,
  "winningPost": { "at": 1006, "side": "near", "model": "winning_post" },
  "furlongPoles": { "side": "far", "furlongs": [1, 2, 3, 4], "modelPrefix": "furlong_" },

  "rails": { "model": "rail_module", "spacing": 3, "sides": ["near", "far"], "gap": 0.4 },

  "ground": { "texture": "grass", "tileSize": 24, "size": 4000 },

  "paths": [
    { "from": [-300, -46], "to": [1500, -46], "width": 5, "texture": "path" },
    { "from": [-300, 44], "to": [1500, 44], "width": 7, "texture": "path" }
  ],

  "trees": [
    { "from": [-300, -70], "to": [1500, -70], "spacing": 26, "jitter": [9, 6], "height": [10, 15], "rows": 1 },
    { "from": [-300, -170], "to": [1500, -170], "spacing": 8, "jitter": [5, 40], "height": [12, 20], "rows": 3, "rowGap": 35 },
    { "from": [-300, 62], "to": [1500, 62], "spacing": 22, "jitter": [8, 4], "height": [10, 14], "rows": 1 },
    { "from": [-300, 130], "to": [1500, 130], "spacing": 11, "jitter": [5, 30], "height": [13, 18], "rows": 2, "rowGap": 30 }
  ],

  "cameras": [
    { "id": "aerial", "label": "Aerial", "follow": "leader", "offset": [-26, 30, 40], "look": [6, 0, -2], "fov": 32 },
    { "id": "tv", "label": "TV", "follow": "leader", "offset": [-6, 5, 52], "look": [-3, 1.2, 0], "fov": 15 },
    { "id": "head", "label": "Head-on", "follow": "leader", "offset": [60, 6, 2], "look": [0, 0.8, 0], "fov": 16 },
    { "id": "post", "label": "At the post", "fixed": [1006, 5, 30], "look": [1006, 1.2, -6], "fov": 34, "followX": 0.35 }
  ],

  "director": [
    { "until": 700, "camera": "aerial" },
    { "until": 900, "camera": "head" },
    { "until": 1006, "camera": "tv" },
    { "until": 99999, "camera": "post" }
  ]
}
